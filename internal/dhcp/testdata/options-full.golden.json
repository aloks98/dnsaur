{
  "control-socket": {
    "socket-name": "/run/kea/kea.sock",
    "socket-type": "unix"
  },
  "hooks-libraries": [
    {
      "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_lease_cmds.so"
    }
  ],
  "interfaces-config": {
    "dhcp-socket-type": "raw",
    "interfaces": [
      "*"
    ]
  },
  "lease-database": {
    "persist": true,
    "type": "memfile"
  },
  "rebind-timer": 3150,
  "renew-timer": 1800,
  "subnet4": [
    {
      "boot-file-name": "pxelinux.0",
      "id": 1,
      "match-client-id": false,
      "next-server": "10.42.0.9",
      "option-data": [
        {
          "data": "10.42.0.1",
          "name": "routers"
        },
        {
          "data": "10.42.0.2",
          "name": "domain-name-servers"
        },
        {
          "data": "home.lan",
          "name": "domain-name"
        },
        {
          "data": "home.lan, lab.lan",
          "name": "domain-search"
        },
        {
          "data": "10.42.0.5, 10.42.0.6",
          "name": "ntp-servers"
        },
        {
          "data": "10.10.0.0/16 - 10.42.0.1, 192.168.5.0/24 - 10.42.0.2",
          "name": "classless-static-route"
        },
        {
          "code": 150,
          "csv-format": false,
          "data": "0A2A0005"
        },
        {
          "code": 44,
          "csv-format": false,
          "data": "0A2A000A"
        }
      ],
      "pools": [
        {
          "pool": "10.42.0.100 - 10.42.0.200"
        }
      ],
      "reservations": [
        {
          "hostname": "printer",
          "hw-address": "aa:bb:cc:dd:ee:01",
          "ip-address": "10.42.0.50"
        }
      ],
      "server-hostname": "boot.lan",
      "subnet": "10.42.0.0/24"
    }
  ],
  "valid-lifetime": 3600
}
