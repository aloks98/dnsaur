[Unit]
Description=dnsaur DNS server
Documentation=https://github.com/aloks98/dnsaur
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/dnsaur -config /etc/dnsaur/dnsaur.yaml
Restart=on-failure
RestartSec=5s

# Port 53 without running as root and without setcap on the binary: systemd
# puts the capability in the process's ambient set, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# No package-created account to leave behind on uninstall. The database and
# the blocklist cache live in the state directory, which systemd creates as
# /var/lib/dnsaur and hands to the same transient UID on every start — the
# path data_dir in the shipped config points at.
DynamicUser=yes
StateDirectory=dnsaur

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
